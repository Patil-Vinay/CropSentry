<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Gazebo 11 gives one material to a whole link, so every coloured part
     is its own link in the URDF. Gazebo merges the fixed links back but keeps
     each part's colour. the box and side plates use a wood texture. -->

<xacro:macro name="gz_colour" params="link rgba">
  <gazebo reference="${link}">
    <visual>
      <material>
        <ambient>${rgba}</ambient>
        <diffuse>${rgba}</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
  </gazebo>
</xacro:macro>

<xacro:macro name="gz_wood" params="link name">
  <gazebo reference="${link}">
    <visual>
      <material>
        <script>
          <uri>model://cropsentry_description/materials/scripts</uri>
          <uri>model://cropsentry_description/materials/textures</uri>
          <name>${name}</name>
        </script>
      </material>
    </visual>
  </gazebo>
</xacro:macro>

<xacro:macro name="gz_friction" params="link mu">
  <gazebo reference="${link}">
    <mu1>${mu}</mu1>
    <mu2>${mu}</mu2>
  </gazebo>
</xacro:macro>

<!-- body -->
<xacro:gz_colour link="base_link" rgba="${aluminium_rgba}"/>
<xacro:gz_colour link="base_actuators_link" rgba="${actuator_rgba}"/>
<xacro:gz_wood link="box_link" name="CropSentry/Oak"/>
<xacro:gz_wood link="box_lid_link" name="CropSentry/OakLid"/>
<xacro:gz_colour link="camera_front_link_1" rgba="${camera_rgba}"/>
<xacro:gz_colour link="camera_rear_link_1" rgba="${camera_rgba}"/>
<xacro:gz_colour link="lidar_link_1" rgba="${lidar_rgba}"/>

<xacro:macro name="gz_side" params="side">
  <xacro:gz_colour link="${side}_side_rail_1" rgba="${aluminium_rgba}"/>
  <xacro:gz_colour link="${side}_gantry_link" rgba="${gantry_rgba}"/>
  <xacro:gz_colour link="${side}_rods_link" rgba="${chrome_rgba}"/>
  <xacro:gz_colour link="${side}_side_module_1" rgba="${aluminium_rgba}"/>
  <xacro:gz_wood link="${side}_side_plate_link" name="CropSentry/Cherry"/>
  <xacro:gz_colour link="${side}_sprayer_link" rgba="${water_rgba}"/>
  <xacro:gz_colour link="${side}_lift_actuator_link" rgba="${actuator_rgba}"/>
  <xacro:gz_colour link="${side}_motors_link" rgba="${motor_rgba}"/>
  <xacro:gz_colour link="${side}_couplers_link" rgba="${coupler_rgba}"/>
  <xacro:gz_colour link="${side}_track_1" rgba="${rubber_rgba}"/>
  <xacro:gz_colour link="camera_sprayer_${side}_link_1" rgba="${camera_rgba}"/>
  <xacro:gz_colour link="front_${side}_sprocket_1" rgba="${nylon_rgba}"/>
  <xacro:gz_colour link="rear_${side}_sprocket_1" rgba="${nylon_rgba}"/>
  <xacro:gz_colour link="front_${side}_road_wheel_1" rgba="${wheel_rgba}"/>
  <xacro:gz_colour link="middle_${side}_road_wheel_1" rgba="${wheel_rgba}"/>
  <xacro:gz_colour link="rear_${side}_road_wheel_1" rgba="${wheel_rgba}"/>
  <xacro:gz_colour link="front_${side}_roller_1" rgba="${wheel_rgba}"/>
  <xacro:gz_colour link="rear_${side}_roller_1" rgba="${wheel_rgba}"/>

  <!-- tracks touch the ground -->
  <xacro:gz_friction link="${side}_track_1" mu="1.0"/>
  <xacro:gz_friction link="front_${side}_sprocket_1" mu="1.0"/>
  <xacro:gz_friction link="rear_${side}_sprocket_1" mu="1.0"/>
  <xacro:gz_friction link="front_${side}_road_wheel_1" mu="1.0"/>
  <xacro:gz_friction link="middle_${side}_road_wheel_1" mu="1.0"/>
  <xacro:gz_friction link="rear_${side}_road_wheel_1" mu="1.0"/>
</xacro:macro>

<xacro:gz_side side="left"/>
<xacro:gz_side side="right"/>

<!-- publish joint states so RViz can show the robot while Gazebo runs -->
<gazebo>
  <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
    <update_rate>30</update_rate>
    <joint_name>left_width_joint</joint_name>
    <joint_name>right_width_joint</joint_name>
    <joint_name>left_lift_joint</joint_name>
    <joint_name>right_lift_joint</joint_name>
    <joint_name>front_left_sprocket_joint</joint_name>
    <joint_name>rear_left_sprocket_joint</joint_name>
    <joint_name>front_left_road_wheel_joint</joint_name>
    <joint_name>middle_left_road_wheel_joint</joint_name>
    <joint_name>rear_left_road_wheel_joint</joint_name>
    <joint_name>front_left_roller_joint</joint_name>
    <joint_name>rear_left_roller_joint</joint_name>
    <joint_name>front_right_sprocket_joint</joint_name>
    <joint_name>rear_right_sprocket_joint</joint_name>
    <joint_name>front_right_road_wheel_joint</joint_name>
    <joint_name>middle_right_road_wheel_joint</joint_name>
    <joint_name>rear_right_road_wheel_joint</joint_name>
    <joint_name>front_right_roller_joint</joint_name>
    <joint_name>rear_right_roller_joint</joint_name>
  </plugin>
</gazebo>

</robot>
