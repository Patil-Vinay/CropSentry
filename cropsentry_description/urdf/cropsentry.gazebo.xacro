<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Gazebo 11 uses one material per link, so these are kept simple.
     cameras, lidar and tracks are merged into their parent links by Gazebo. -->

<xacro:macro name="gz_link" params="link material mu">
  <gazebo reference="${link}">
    <material>${material}</material>
    <mu1>${mu}</mu1>
    <mu2>${mu}</mu2>
  </gazebo>
</xacro:macro>

<xacro:gz_link link="base_link" material="Gazebo/Grey" mu="0.2"/>
<xacro:gz_link link="left_side_rail_1" material="Gazebo/Grey" mu="0.2"/>
<xacro:gz_link link="right_side_rail_1" material="Gazebo/Grey" mu="0.2"/>
<xacro:gz_link link="left_side_module_1" material="Gazebo/DarkGrey" mu="1.0"/>
<xacro:gz_link link="right_side_module_1" material="Gazebo/DarkGrey" mu="1.0"/>

<xacro:macro name="gz_wheels" params="side">
  <xacro:gz_link link="front_${side}_sprocket_1" material="Gazebo/White" mu="1.0"/>
  <xacro:gz_link link="rear_${side}_sprocket_1" material="Gazebo/White" mu="1.0"/>
  <xacro:gz_link link="front_${side}_road_wheel_1" material="Gazebo/White" mu="1.0"/>
  <xacro:gz_link link="middle_${side}_road_wheel_1" material="Gazebo/White" mu="1.0"/>
  <xacro:gz_link link="rear_${side}_road_wheel_1" material="Gazebo/White" mu="1.0"/>
  <xacro:gz_link link="front_${side}_roller_1" material="Gazebo/White" mu="1.0"/>
  <xacro:gz_link link="rear_${side}_roller_1" material="Gazebo/White" mu="1.0"/>
</xacro:macro>

<xacro:gz_wheels side="left"/>
<xacro:gz_wheels side="right"/>

<!-- publish joint states so RViz can show the robot while Gazebo runs -->
<gazebo>
  <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
    <update_rate>30</update_rate>
    <joint_name>left_width_joint</joint_name>
    <joint_name>right_width_joint</joint_name>
    <joint_name>left_lift_joint</joint_name>
    <joint_name>right_lift_joint</joint_name>
    <joint_name>front_left_sprocket_joint</joint_name>
    <joint_name>rear_left_sprocket_joint</joint_name>
    <joint_name>front_left_road_wheel_joint</joint_name>
    <joint_name>middle_left_road_wheel_joint</joint_name>
    <joint_name>rear_left_road_wheel_joint</joint_name>
    <joint_name>front_left_roller_joint</joint_name>
    <joint_name>rear_left_roller_joint</joint_name>
    <joint_name>front_right_sprocket_joint</joint_name>
    <joint_name>rear_right_sprocket_joint</joint_name>
    <joint_name>front_right_road_wheel_joint</joint_name>
    <joint_name>middle_right_road_wheel_joint</joint_name>
    <joint_name>rear_right_road_wheel_joint</joint_name>
    <joint_name>front_right_roller_joint</joint_name>
    <joint_name>rear_right_roller_joint</joint_name>
  </plugin>
</gazebo>

</robot>
