<?xml version="1.0" ?>
<robot name="cropsentry" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- CropSentry robot. Exported from Fusion 360 with fusion2urdf and edited by hand.
     width joints move the side rails out, lift joints raise the body.
     right side follows the left side through mimic. -->

<xacro:include filename="$(find cropsentry_description)/urdf/materials.xacro" />
<xacro:include filename="$(find cropsentry_description)/urdf/cropsentry.gazebo.xacro" />

<!-- meshes are in mm -->
<xacro:property name="mesh_scale" value="0.001 0.001 0.001" />

<!-- empty root link, KDL does not like inertia on the root -->
<link name="base_footprint"/>

<joint name="base_joint" type="fixed">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="base_link"/>
</joint>

<link name="base_link">
  <inertial>
    <origin xyz="-0.0028997388406951535 0.002000864602341355 0.39394531511524705" rpy="0 0 0"/>
    <mass value="9.078029323053778"/>
    <inertia ixx="0.324068" iyy="0.28302" izz="0.4143" ixy="-1e-06" iyz="0.000866" ixz="-8e-05"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://cropsentry_description/meshes/base_link__frame.stl" scale="${mesh_scale}"/>
    </geometry>
    <material name="aluminium"/>
  </visual>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://cropsentry_description/meshes/base_link__actuators.stl" scale="${mesh_scale}"/>
    </geometry>
    <material name="actuator_grey"/>
  </visual>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://cropsentry_description/meshes/base_link__box.stl" scale="${mesh_scale}"/>
    </geometry>
    <material name="oak_wood"/>
  </visual>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://cropsentry_description/meshes/base_link__box_lid.stl" scale="${mesh_scale}"/>
    </geometry>
    <material name="oak_wood_lid"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://cropsentry_description/meshes/base_link.stl" scale="${mesh_scale}"/>
    </geometry>
  </collision>
</link>

