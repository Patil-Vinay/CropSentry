<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- colours taken from the Fusion appearances, cropsentry.gazebo.xacro uses the same values -->
<xacro:property name="aluminium_rgba" value="0.78 0.79 0.81 1"/>
<xacro:property name="gantry_rgba" value="0.08 0.08 0.09 1"/>
<xacro:property name="chrome_rgba" value="0.86 0.87 0.89 1"/>
<xacro:property name="actuator_rgba" value="0.72 0.73 0.74 1"/>
<xacro:property name="oak_rgba" value="0.78 0.64 0.46 1"/>
<xacro:property name="oak_lid_rgba" value="0.84 0.73 0.57 1"/>
<xacro:property name="cherry_rgba" value="0.45 0.2 0.12 1"/>
<xacro:property name="motor_rgba" value="0.66 0.66 0.68 1"/>
<xacro:property name="coupler_rgba" value="0.95 0.45 0.12 1"/>
<xacro:property name="water_rgba" value="0.15 0.45 0.85 1"/>
<xacro:property name="rubber_rgba" value="0.06 0.06 0.06 1"/>
<xacro:property name="tread_rgba" value="0.03 0.03 0.03 1"/>
<xacro:property name="nylon_rgba" value="0.93 0.93 0.91 1"/>
<xacro:property name="wheel_rgba" value="0.86 0.86 0.86 1"/>
<xacro:property name="camera_rgba" value="0.1 0.1 0.1 1"/>
<xacro:property name="lidar_rgba" value="0.2 0.2 0.22 1"/>

<material name="aluminium"><color rgba="${aluminium_rgba}"/></material>
<material name="gantry_black"><color rgba="${gantry_rgba}"/></material>
<material name="chrome"><color rgba="${chrome_rgba}"/></material>
<material name="actuator_grey"><color rgba="${actuator_rgba}"/></material>
<material name="oak_wood"><color rgba="${oak_rgba}"/></material>
<material name="oak_wood_lid"><color rgba="${oak_lid_rgba}"/></material>
<material name="cherry_wood"><color rgba="${cherry_rgba}"/></material>
<material name="motor_grey"><color rgba="${motor_rgba}"/></material>
<material name="coupler_orange"><color rgba="${coupler_rgba}"/></material>
<material name="water_blue"><color rgba="${water_rgba}"/></material>
<material name="rubber_black"><color rgba="${rubber_rgba}"/></material>
<material name="tread_black"><color rgba="${tread_rgba}"/></material>
<material name="nylon_white"><color rgba="${nylon_rgba}"/></material>
<material name="wheel_white"><color rgba="${wheel_rgba}"/></material>
<material name="camera_black"><color rgba="${camera_rgba}"/></material>
<material name="lidar_dark"><color rgba="${lidar_rgba}"/></material>

</robot>
