<?xml version="1.0"?>
<sdf version="1.6">
  <world name="crop_field">
    <!-- plot A: low strawberry beds, the robot passes at its smallest size.
         plot B: bigger plants, the robot has to widen and lift first.
         the robot starts at the origin facing the middle row of both plots. -->

    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 40</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 40</size></plane>
          </geometry>
          <material>
            <ambient>0.45 0.36 0.25 1</ambient>
            <diffuse>0.45 0.36 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- raised soil beds under the strawberry rows, 30 cm wide and 4 cm high -->
    <model name="strawberry_beds">
      <static>true</static>
      <link name="link">
        <collision name="bed_right">
          <pose>2.65 -0.8 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
        </collision>
        <visual name="bed_right">
          <pose>2.65 -0.8 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.13 1</ambient>
            <diffuse>0.32 0.22 0.13 1</diffuse>
          </material>
        </visual>
        <collision name="bed_middle">
          <pose>2.65 0 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
        </collision>
        <visual name="bed_middle">
          <pose>2.65 0 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.13 1</ambient>
            <diffuse>0.32 0.22 0.13 1</diffuse>
          </material>
        </visual>
        <collision name="bed_left">
          <pose>2.65 0.8 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
        </collision>
        <visual name="bed_left">
          <pose>2.65 0.8 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
          <material>
            <ambient>0.32 0.22 0.13 1</ambient>
            <diffuse>0.32 0.22 0.13 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- plot A row 1 -->
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_1</name><pose>1.0 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_2</name><pose>1.3 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_3</name><pose>1.6 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_4</name><pose>1.9 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_5</name><pose>2.2 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_6</name><pose>2.5 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_7</name><pose>2.8 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_8</name><pose>3.1 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_9</name><pose>3.4 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_10</name><pose>3.7 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_11</name><pose>4.0 -0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_12</name><pose>4.3 -0.8 0.04 0 0 0</pose></include>
    <!-- plot A row 2 -->
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_1</name><pose>1.0 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_2</name><pose>1.3 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_3</name><pose>1.6 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_4</name><pose>1.9 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_5</name><pose>2.2 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_6</name><pose>2.5 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_7</name><pose>2.8 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_8</name><pose>3.1 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_9</name><pose>3.4 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_10</name><pose>3.7 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_11</name><pose>4.0 0.0 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_2_12</name><pose>4.3 0.0 0.04 0 0 0</pose></include>
    <!-- plot A row 3 -->
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_1</name><pose>1.0 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_2</name><pose>1.3 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_3</name><pose>1.6 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_4</name><pose>1.9 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_5</name><pose>2.2 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_6</name><pose>2.5 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_7</name><pose>2.8 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_8</name><pose>3.1 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_9</name><pose>3.4 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_10</name><pose>3.7 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_11</name><pose>4.0 0.8 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_3_12</name><pose>4.3 0.8 0.04 0 0 0</pose></include>
    <!-- plot B row 1 -->
    <include><uri>model://tall_plant</uri><name>tall_1_1</name><pose>6.5 -1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_1_2</name><pose>7.0 -1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_1_3</name><pose>7.5 -1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_1_4</name><pose>8.0 -1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_1_5</name><pose>8.5 -1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_1_6</name><pose>9.0 -1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_1_7</name><pose>9.5 -1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_1_8</name><pose>10.0 -1.0 0 0 0 0</pose></include>
    <!-- plot B row 2 -->
    <include><uri>model://tall_plant</uri><name>tall_2_1</name><pose>6.5 0.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_2_2</name><pose>7.0 0.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_2_3</name><pose>7.5 0.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_2_4</name><pose>8.0 0.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_2_5</name><pose>8.5 0.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_2_6</name><pose>9.0 0.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_2_7</name><pose>9.5 0.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_2_8</name><pose>10.0 0.0 0 0 0 0</pose></include>
    <!-- plot B row 3 -->
    <include><uri>model://tall_plant</uri><name>tall_3_1</name><pose>6.5 1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_3_2</name><pose>7.0 1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_3_3</name><pose>7.5 1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_3_4</name><pose>8.0 1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_3_5</name><pose>8.5 1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_3_6</name><pose>9.0 1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_3_7</name><pose>9.5 1.0 0 0 0 0</pose></include>
    <include><uri>model://tall_plant</uri><name>tall_3_8</name><pose>10.0 1.0 0 0 0 0</pose></include>

    <gui>
      <camera name="user_camera">
        <pose>-3.0 -4.0 3.0 0 0.45 0.9</pose>
      </camera>
    </gui>
  </world>
</sdf>
