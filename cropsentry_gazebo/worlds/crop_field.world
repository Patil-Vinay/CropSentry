<?xml version="1.0"?>
<sdf version="1.6">
  <world name="crop_field">
    <!-- plot A: low strawberry beds, the robot passes at its smallest size.
         plot B: bigger plants, the robot has to widen and lift first.
         both plots have 5 rows. the robot starts at the origin, in the headland west of plot A. -->

    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.62 0.78 0.92 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>4</speed>
          <humidity>0.4</humidity>
        </clouds>
      </sky>
    </scene>

    <!-- grass everywhere, the field inside the fence is covered with soil -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>80 80</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>80 80</size></plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://field_soil</uri>
      <pose>5 0 0 0 0 0</pose>
    </include>

    <!-- strawberry beds covered with black mulch, 30 cm wide and 4 cm high -->
    <model name="strawberry_beds">
      <static>true</static>
      <link name="link">
        <collision name="bed_1">
          <pose>2.65 -1.6 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
        </collision>
        <visual name="bed_1">
          <pose>2.65 -1.6 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
          <material>
            <ambient>0.06 0.06 0.06 1</ambient>
            <diffuse>0.06 0.06 0.06 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="bed_2">
          <pose>2.65 -0.8 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
        </collision>
        <visual name="bed_2">
          <pose>2.65 -0.8 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
          <material>
            <ambient>0.06 0.06 0.06 1</ambient>
            <diffuse>0.06 0.06 0.06 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="bed_3">
          <pose>2.65 0 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
        </collision>
        <visual name="bed_3">
          <pose>2.65 0 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
          <material>
            <ambient>0.06 0.06 0.06 1</ambient>
            <diffuse>0.06 0.06 0.06 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="bed_4">
          <pose>2.65 0.8 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
        </collision>
        <visual name="bed_4">
          <pose>2.65 0.8 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
          <material>
            <ambient>0.06 0.06 0.06 1</ambient>
            <diffuse>0.06 0.06 0.06 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="bed_5">
          <pose>2.65 1.6 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
        </collision>
        <visual name="bed_5">
          <pose>2.65 1.6 0.02 0 0 0</pose>
          <geometry><box><size>3.9 0.3 0.04</size></box></geometry>
          <material>
            <ambient>0.06 0.06 0.06 1</ambient>
            <diffuse>0.06 0.06 0.06 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- plot A row 1 -->
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_1</name><pose>1.0 -1.6 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_2</name><pose>1.3 -1.6 0.04 0 0 0</pose></include>
    <include><uri>model://strawberry_plant</uri><name>strawberry_1_3</name><pose>1.6 -1.6 0.04 0 0 0</pose></include>
